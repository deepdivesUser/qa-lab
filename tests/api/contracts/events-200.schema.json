{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events-200",
  "title": "GET /events 200",
  "description": "Org-scoped list. tickets is the summed qty across kinds — the number the data suite reconciles against SQL.",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "startsAt", "tickets"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "published"] },
          "startsAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
          "tickets": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
